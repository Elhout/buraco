# Copy to .env.local (never commit real values). EXPO_PUBLIC_* are bundled into the app: public values only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
EXPO_PUBLIC_SENTRY_DSN=
# Web build only (iPhone home-screen app): public VAPID key, see supabase/functions/README.md
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Build-time only (app.config.ts / EAS)
EAS_PROJECT_ID=
APP_BUNDLE_ID=com.buraco.score
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN goes in EAS secrets, not here.
